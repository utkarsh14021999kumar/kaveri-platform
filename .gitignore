# --- Terraform local working data (regenerated by terraform init) ---
**/.terraform/*

# --- State: never commit (remote state lives in GCS) ---
*.tfstate
*.tfstate.*

# --- Plan files can contain sensitive values ---
*.tfplan
tfplan*

# --- Variable files can hold secrets; commit only *.tfvars.example ---
*.tfvars
*.tfvars.json
!*.tfvars.example

# --- Terraform crash logs and local overrides ---
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Lock files: commit ROOT lock files only (bootstrap, environments) ---
platform-infra/terraform/modules/**/.terraform.lock.hcl

# --- Credentials: never commit ---
*credentials*.json
*-key.json
key.json

# --- Editor / OS ---
*.swp
.DS_Store
.idea/
.vscode/
